# ============================================================================
# Food Store — Backend Environment Variables
# Copiá este archivo como .env en la raíz del proyecto.
# ============================================================================

# --- Base de Datos (valores por defecto para Docker Compose) ---
DB_HOST=db                 # Usar "localhost" fuera de Docker
DB_PORT=5432
DB_USER=foodstore
DB_PASS=foodstore123
DB_NAME=foodstore_db

# --- JWT ---
SECRET_KEY=changeme-use-at-least-32-random-chars-here-123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Entorno ---
ENV=development            # development | production

# --- MercadoPago (claves de sandbox para desarrollo local) ---
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-00000000
MP_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
MP_NOTIFICATION_URL=https://tu-dominio.com/api/v1/pagos/webhook

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173"]
