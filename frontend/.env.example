# ============================================================================
# Food Store — Frontend Environment Variables
# Copiá este archivo como frontend/.env
# ============================================================================

# URL base de la API del backend (en Docker Compose el proxy nginx lo resuelve)
# Para desarrollo local con Vite: http://localhost:8000
VITE_API_URL=http://localhost:8000

# Timeout de requests HTTP en milisegundos
VITE_API_TIMEOUT=10000

# Nombre de la aplicación
VITE_APP_NAME=Food Store

# Clave pública de MercadoPago (sandbox para desarrollo)
VITE_MP_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
