# Ejemplo de variables de entorno para backend Food Store
# Nunca subir .env real, solo .env.example

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=devuser
DB_PASS=devpass
DB_NAME=foodstore_dev

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Environment
ENV=development
